{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "BucketWrite",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:ListBucket",
        "s3:GetObject"
      ],
      "Resource": [
        "arn:aws:s3:::jv-grc-portfolio-442426872368",
        "arn:aws:s3:::jv-grc-portfolio-442426872368/*"
      ]
    },
    {
      "Sid": "CloudFrontInvalidate",
      "Effect": "Allow",
      "Action": "cloudfront:CreateInvalidation",
      "Resource": "arn:aws:cloudfront::442426872368:distribution/E2CBSIDVRRMG1W"
    }
  ]
}